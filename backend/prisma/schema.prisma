// School Management Platform — Prisma schema (CONTRACT v1.0 + v2 additions, contracts/SCHEMA.md)
// v2 (2026-11-06): additive-only. All v1 tables/columns stay untouched; new columns are
// nullable or have defaults, and 20 new tables are added below. CHECK constraints for
// the new/changed enums live in the v2 migration SQL (same pattern as v1 — Prisma 6.x
// has no @@check). Migration: prisma/migrations/<ts>_v2_schema/migration.sql.
// PostgreSQL 16. All timestamps timestamptz (UTC); all dates school-local `date`.
// Money is integer PKR. Phone numbers are stored encrypted (*_phone_enc, AES-256-GCM,
// key from PHONE_ENC_KEY) + SHA-256 hash of the E.164-normalized number (*_phone_hash)
// for duplicate detection only. Encryption/decryption lives in backend src/lib/crypto.ts
// (Backend Agent); this schema only stores the ciphertext + hash.
//
// NOTE — CHECK constraints: Prisma 6.x does not support @@check in the schema, so
// all contract CHECK constraints (roles, statuses, types, languages, actor types)
// are enforced in the migration SQL (prisma/migrations/<ts>_init/migration.sql)
// as ALTER TABLE ... ADD CONSTRAINT statements. Do NOT re-add @@check here —
// `prisma validate` rejects it. If the schema changes, regenerate the migration
// and re-apply the CHECK + generated-column edits (see migration.sql header).
//
// KNOWN PRISMA LIMITATION — fee_records.status: the contract requires it GENERATED
// from amounts (unpaid/partial/paid). Prisma cannot declare a generated column, so the
// migration SQL (prisma/migrations/<ts>_init/migration.sql) defines it as
//   GENERATED ALWAYS AS (CASE WHEN amount_paid + discount >= amount_due THEN 'paid'
//     WHEN amount_paid + discount > 0 THEN 'partial' ELSE 'unpaid' END) STORED
// The field below is declared as a plain column so Prisma Client can READ it.
// >>> NEVER pass `status` in a create/update for FeeRecord — Postgres rejects writes
// to a generated column. The Fee Agent must omit it; the DB computes it. <<<

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  timezone  String   @default("Asia/Karachi")
  country   String   @default("PK")
  settings  Json     @default("{}") @db.JsonB
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  users             User[]
  classes           Class[]
  students          Student[]
  attendanceDays    AttendanceDay[]
  teacherAttendance TeacherAttendance[]
  feeStructures     FeeStructure[]
  feeRecords        FeeRecord[]
  messageTemplates  MessageTemplate[]
  messageQueue      MessageQueue[]
  smsDevices        SmsDevice[]
  holidays          Holiday[]
  academicSessions  AcademicSession[]
  promotions        Promotion[]
  leaveApplications LeaveApplication[]
  ocrUploads        OcrUpload[]
  auditLogs         AuditLog[]
  notifications     Notification[]

  // v2 additions
  rolePermissions         RolePermission[]
  approvalRequests        ApprovalRequest[]
  deletedRecords          DeletedRecord[]
  changeLogs              ChangeLog[]
  exams                   Exam[]
  gradingScales           GradingScale[]
  resultSheets            ResultSheet[]
  results                 Result[]
  timetableEntries        TimetableEntry[]
  staff                   Staff[]
  staffClassAssignments   StaffClassAssignment[]
  salaryRecords           SalaryRecord[]
  expenses                Expense[]
  announcements           Announcement[]
  events                  Event[]
  certificates            Certificate[]
  examDatesheets          ExamDatesheet[]
  feeVouchers             FeeVoucher[]
  accountDeletionRequests AccountDeletionRequest[]
  schoolBackups           SchoolBackup[]
  messageDrafts           MessageDraft[]

  @@map("schools")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  schoolId        String    @db.Uuid
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  email           String    @unique @db.Citext
  passwordHash    String
  role            String
  emailVerified   Boolean   @default(false)
  verifyTokenHash String?
  verifyExpiresAt DateTime? @db.Timestamptz(6)
  resetTokenHash  String?
  resetExpiresAt  DateTime? @db.Timestamptz(6)
  lastLoginAt     DateTime? @db.Timestamptz(6)
  // v2: TOTP 2FA. totpSecretEnc is the TOTP secret encrypted with the same
  // AES-256-GCM phone-encryption key pattern (base64(iv||tag||ct)); never
  // store or return it in plaintext. loginAlerts emails the user on login.
  totpSecretEnc   String?
  totpEnabled     Boolean   @default(false)
  loginAlerts     Boolean   @default(true)
  lastLoginIp     String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)

  // v2 relations
  approvalRequestsRequested ApprovalRequest[]        @relation("ApprovalRequestedBy")
  approvalRequestsDecided   ApprovalRequest[]        @relation("ApprovalDecidedBy")
  changeLogs                ChangeLog[]
  certificatesIssued        Certificate[]
  expensesCreated           Expense[]
  announcementsCreated      Announcement[]
  accountDeletionRequests   AccountDeletionRequest[]
  deletedRecords            DeletedRecord[]
  messageDraftsCreated      MessageDraft[]

  @@index([schoolId, email])
  @@map("users")
}

model Class {
  id                  String    @id @default(uuid()) @db.Uuid
  schoolId            String    @db.Uuid
  school              School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name                String
  section             String
  teacherName         String
  teacherPhoneEnc     String?
  teacherPhoneHash    String?
  attendanceTokenHash String?
  attendanceTokenEnc  String?
  tokenExpiresAt      DateTime? @db.Timestamptz(6)
  tokenRevoked        Boolean   @default(false)
  // v2: soft delete — list queries must exclude rows where deletedAt IS NOT NULL.
  deletedAt           DateTime? @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6)

  students          Student[]
  attendanceDays    AttendanceDay[]
  teacherAttendance TeacherAttendance[]
  feeStructures     FeeStructure[]
  messageQueue      MessageQueue[]
  ocrUploads        OcrUpload[]
  promotionsFrom    Promotion[]         @relation("PromotionFrom")
  promotionsTo      Promotion[]         @relation("PromotionTo")

  // v2 relations
  gradingScales         GradingScale[]
  resultSheets          ResultSheet[]
  results               Result[]
  timetableEntries      TimetableEntry[]
  staffAssignments      StaffClassAssignment[]
  examDatesheets        ExamDatesheet[]
  announcementsTargeted Announcement[]
  messageDraftsTargeted MessageDraft[]

  @@unique([schoolId, name, section])
  @@index([schoolId, deletedAt])
  @@map("classes")
}

model Student {
  id               String    @id @default(uuid()) @db.Uuid
  schoolId         String    @db.Uuid
  school           School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId          String    @db.Uuid
  class            Class     @relation(fields: [classId], references: [id], onDelete: Restrict)
  rollNo           Int?
  name             String
  nameUr           String?
  parentName       String?
  parentPhoneEnc   String?
  parentPhoneHash  String?
  parentOptOut     Boolean   @default(false)
  status           String    @default("active")
  // v2: extended profile. admissionNo is unique per school (NULLs distinct in
  // Postgres, so students without an admission number never collide).
  fatherName       String?
  admissionNo      String?
  dateOfBirth      DateTime? @db.Date
  gender           String?
  address          String?
  admissionDate    DateTime? @db.Date
  // v2: second parent/guardian contact — same AES-256-GCM enc + SHA-256 hash
  // pattern as parentPhoneEnc/Hash; parent2OptOut means NEVER message it.
  parent2Name      String?
  parent2PhoneEnc  String?
  parent2PhoneHash String?
  parent2OptOut    Boolean   @default(false)
  // v2: soft delete — list queries must exclude rows where deletedAt IS NOT NULL.
  deletedAt        DateTime? @db.Timestamptz(6)
  // v2: ID-card flag — set when the student's ID card is issued (no separate table).
  idCardIssuedAt   DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)

  attendanceRecords AttendanceRecord[]
  feeRecords        FeeRecord[]
  messageQueue      MessageQueue[]
  leaveApplications LeaveApplication[]
  promotions        Promotion[]

  // v2 relations
  results      Result[]
  certificates Certificate[]

  // Postgres treats NULLs as distinct in a unique index, so this unique index
  // enforces (class_id, roll_no) only when roll_no IS NOT NULL — exactly the
  // contract's partial-unique rule.
  @@unique([classId, rollNo])
  @@unique([schoolId, admissionNo])
  @@index([schoolId, classId])
  @@index([schoolId, parentPhoneHash])
  @@index([schoolId, deletedAt])
  @@map("students")
}

model AttendanceDay {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @db.Uuid
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId     String   @db.Uuid
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  submittedBy String
  submittedAt DateTime @db.Timestamptz(6)
  unlocked    Boolean  @default(false)
  unlockedBy  String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  records AttendanceRecord[]

  @@unique([classId, date])
  @@map("attendance_days")
}

model AttendanceRecord {
  id              String        @id @default(uuid()) @db.Uuid
  attendanceDayId String        @db.Uuid
  attendanceDay   AttendanceDay @relation(fields: [attendanceDayId], references: [id], onDelete: Cascade)
  studentId       String        @db.Uuid
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status          String
  markedAt        DateTime      @db.Timestamptz(6)
  updatedBy       String

  @@unique([attendanceDayId, studentId])
  @@index([studentId, status])
  @@map("attendance_records")
}

model TeacherAttendance {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId   String   @db.Uuid
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  status    String
  markedBy  String?  @db.Uuid
  note      String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([classId, date])
  @@map("teacher_attendance")
}

model FeeStructure {
  id                 String   @id @default(uuid()) @db.Uuid
  schoolId           String   @db.Uuid
  school             School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId            String   @db.Uuid
  class              Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  monthlyAmount      Int
  effectiveFrom      DateTime @db.Date
  // v2: one-time admission fee (PKR) and sibling discount percent (0-100).
  admissionFee       Int      @default(0)
  siblingDiscountPct Int      @default(0)
  createdAt          DateTime @default(now()) @db.Timestamptz(6)

  @@index([classId, effectiveFrom])
  @@map("fee_structures")
}

model FeeRecord {
  id                  String    @id @default(uuid()) @db.Uuid
  schoolId            String    @db.Uuid
  school              School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId           String    @db.Uuid
  student             Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  month               String
  amountDue           Int
  amountPaid          Int       @default(0)
  discount            Int       @default(0)
  // v2: arrears carried from prior months (PKR) and scholarship discount (PKR).
  // NOTE: fee_records.status is GENERATED from amountPaid + discount vs
  // amountDue only — arrears/scholarshipDiscount do NOT feed the generated
  // status; the Fees phase must include them in amountDue when creating the
  // record (or in the payable total shown to the user).
  arrears             Int       @default(0)
  scholarshipDiscount Int       @default(0)
  // v2: soft delete — list queries must exclude rows where deletedAt IS NOT NULL.
  deletedAt           DateTime? @db.Timestamptz(6)
  // GENERATED in migration SQL (see header comment). Read-only from Prisma.
  // @default(dbgenerated(...)) tells Prisma the DB computes the value, so
  // Prisma OMITS this column from INSERT/UPDATE (a plain @default would be
  // sent by Prisma and Postgres rejects writes to GENERATED ALWAYS columns —
  // that broke `prisma/seed.ts` on a live DB, QA 2026-11-06).
  // NOTE: `prisma migrate diff` may show drift for this column (it renders
  // dbgenerated as a plain DEFAULT); do NOT apply it — the checked-in
  // migration SQL (GENERATED ALWAYS) is authoritative.
  status              String    @default(dbgenerated("(CASE WHEN \"amountPaid\" + \"discount\" >= \"amountDue\" THEN 'paid' WHEN \"amountPaid\" + \"discount\" > 0 THEN 'partial' ELSE 'unpaid' END)"))
  paidAt              DateTime? @db.Timestamptz(6)
  receiptNo           String?
  paymentMethod       String?
  markedBy            String?   @db.Uuid
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6)

  // v2 relation
  feeVouchers FeeVoucher[]

  @@unique([studentId, month])
  @@index([schoolId, month])
  @@index([receiptNo])
  @@index([schoolId, deletedAt])
  @@map("fee_records")
}

model MessageTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  type      String
  language  String
  body      String
  // v2 (Section 11 — Custom Messages): admin-editable label; nothing is
  // locked — any template (seeded or custom) can be edited, renamed,
  // duplicated, or deleted by the school's own admin. Templates are always
  // per-school copies, never shared across schools. Types now also include
  // 'result', 'announcement', 'custom' (CHECK extended in the v2 migration).
  name      String?
  isCustom  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  // Round 5 (F11): the old key (school, type, language) allowed exactly ONE
  // custom template per language, so Duplicate always 409'd once any
  // custom template existed — and creating a second custom template failed
  // the same way. Names are required on create and seeded defaults are
  // backfilled by the migration, so (school, type, language, name) keeps
  // one active wording per type/language/name while letting a school hold
  // several custom templates. getActiveTemplate (sends) still resolves by
  // type + language + isActive; system types keep a single row per
  // language because their seeded names are distinct per type/language.
  @@unique([schoolId, type, language, name])
  @@map("message_templates")
}

model MessageQueue {
  id             String    @id @default(uuid()) @db.Uuid
  schoolId       String    @db.Uuid
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  type           String
  studentId      String?   @db.Uuid
  student        Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId        String?   @db.Uuid
  class          Class?    @relation(fields: [classId], references: [id], onDelete: Cascade)
  parentPhoneEnc String
  body           String
  status         String    @default("queued")
  attempts       Int       @default(0)
  dedupeKey      String    @unique
  scheduledFor   DateTime  @db.Timestamptz(6)
  sentAt         DateTime? @db.Timestamptz(6)
  error          String?
  approvedBy     String?   @db.Uuid
  approvedAt     DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  deliveries MessageDelivery[]

  @@index([schoolId, status, scheduledFor])
  @@map("message_queue")
}

model MessageDelivery {
  id          String       @id @default(uuid()) @db.Uuid
  queueId     String       @db.Uuid
  queue       MessageQueue @relation(fields: [queueId], references: [id], onDelete: Cascade)
  provider    String
  deviceId    String?      @db.Uuid
  status      String
  deliveredAt DateTime?    @db.Timestamptz(6)
  error       String?
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)

  @@index([queueId])
  @@map("message_deliveries")
}

model SmsDevice {
  id         String    @id @default(uuid()) @db.Uuid
  schoolId   String    @db.Uuid
  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  deviceId   String    @unique
  name       String
  lastSeenAt DateTime? @db.Timestamptz(6)
  status     String    @default("offline")
  pushToken  String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  @@map("sms_devices")
}

model Holiday {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([schoolId, date])
  @@map("holidays")
}

model AcademicSession {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  promotions Promotion[]

  // v2 relations
  exams        Exam[]
  resultSheets ResultSheet[]

  @@map("academic_sessions")
}

model Promotion {
  id          String          @id @default(uuid()) @db.Uuid
  schoolId    String          @db.Uuid
  school      School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId   String          @db.Uuid
  student     Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromClassId String          @db.Uuid
  fromClass   Class           @relation("PromotionFrom", fields: [fromClassId], references: [id], onDelete: Restrict)
  toClassId   String          @db.Uuid
  toClass     Class           @relation("PromotionTo", fields: [toClassId], references: [id], onDelete: Restrict)
  sessionId   String          @db.Uuid
  session     AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  promotedAt  DateTime        @db.Timestamptz(6)
  promotedBy  String?         @db.Uuid

  @@map("promotions")
}

model LeaveApplication {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String   @db.Uuid
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromDate  DateTime @db.Date
  toDate    DateTime @db.Date
  reason    String
  status    String   @default("pending")
  decidedBy String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@map("leave_applications")
}

model OcrUpload {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId   String   @db.Uuid
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  filePath  String
  status    String
  rawText   String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@map("ocr_uploads")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actorId   String?  @db.Uuid
  actorType String
  action    String
  entity    String
  entityId  String?  @db.Uuid
  details   Json     @default("{}") @db.JsonB
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([schoolId, createdAt])
  @@map("audit_logs")
}

model Notification {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @db.Uuid
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  type        String
  title       String
  body        String
  relatedType String?
  relatedId   String?  @db.Uuid
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([schoolId, isRead, createdAt])
  @@map("notifications")
}

// ============================================================================
// v2 ADDITIONS (2026-11-06) — additive only; see contracts/SCHEMA.md "v2 additions".
// Every new table has school_id UUID FK schools ON DELETE CASCADE + an index on
// school_id. Money is integer PKR. Dates are school-local `date`; timestamps
// timestamptz. Phones follow the AES-256-GCM enc + SHA-256 hash pattern.
// CHECK constraints live in the v2 migration SQL (Prisma 6.x has no @@check).
// ============================================================================

model RolePermission {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  role      String
  resource  String
  action    String
  allowed   Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([schoolId, role, resource, action])
  @@index([schoolId, role])
  @@map("role_permissions")
}

model ApprovalRequest {
  id          String    @id @default(uuid()) @db.Uuid
  schoolId    String    @db.Uuid
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  requestedBy String    @db.Uuid
  requester   User      @relation("ApprovalRequestedBy", fields: [requestedBy], references: [id], onDelete: Cascade)
  actionType  String
  entity      String
  entityId    String?   @db.Uuid
  payload     Json      @db.JsonB
  status      String    @default("pending")
  decidedBy   String?   @db.Uuid
  decider     User?     @relation("ApprovalDecidedBy", fields: [decidedBy], references: [id], onDelete: SetNull)
  decidedAt   DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  @@index([schoolId, status, createdAt])
  @@map("approval_requests")
}

model DeletedRecord {
  id                   String    @id @default(uuid()) @db.Uuid
  schoolId             String    @db.Uuid
  school               School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  entity               String
  entityId             String    @db.Uuid
  snapshot             Json      @db.JsonB
  deletedBy            String?   @db.Uuid
  deleter              User?     @relation(fields: [deletedBy], references: [id], onDelete: SetNull)
  deletedAt            DateTime  @default(now()) @db.Timestamptz(6)
  // Restore deadline: deletedAt + 30 days. A purge job permanently deletes
  // rows past restoreBy and sets permanentlyDeletedAt.
  restoreBy            DateTime? @db.Timestamptz(6)
  permanentlyDeletedAt DateTime? @db.Timestamptz(6)

  @@index([schoolId, entity, deletedAt])
  @@index([restoreBy])
  @@map("deleted_records")
}

model ChangeLog {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actorId   String?  @db.Uuid
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorType String
  entity    String
  entityId  String?  @db.Uuid
  field     String
  oldValue  String?
  newValue  String?
  changedAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([schoolId, entity, entityId, changedAt])
  @@map("change_logs")
}

model Exam {
  id        String           @id @default(uuid()) @db.Uuid
  schoolId  String           @db.Uuid
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  sessionId String?          @db.Uuid
  session   AcademicSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  startDate DateTime?        @db.Date
  endDate   DateTime?        @db.Date
  // v2: soft delete — list queries must exclude rows where deletedAt IS NOT NULL.
  deletedAt DateTime?        @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)

  resultSheets ResultSheet[]
  results      Result[]
  datesheets   ExamDatesheet[]

  @@index([schoolId, sessionId])
  @@index([schoolId, deletedAt])
  @@map("exams")
}

model GradingScale {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId   String?  @db.Uuid
  class     Class?   @relation(fields: [classId], references: [id], onDelete: Cascade)
  minMarks  Int
  maxMarks  Int
  grade     String
  gpaPoints Float
  isPassing Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([schoolId, classId])
  @@map("grading_scales")
}

model ResultSheet {
  id        String           @id @default(uuid()) @db.Uuid
  schoolId  String           @db.Uuid
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  examId    String           @db.Uuid
  exam      Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  classId   String           @db.Uuid
  class     Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  sessionId String?          @db.Uuid
  session   AcademicSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  filePath  String
  status    String           @default("processing")
  rawText   String?
  deletedAt DateTime?        @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)

  results Result[]

  @@index([schoolId, examId, classId])
  @@index([schoolId, status])
  @@map("result_sheets")
}

model Result {
  id            String       @id @default(uuid()) @db.Uuid
  schoolId      String       @db.Uuid
  school        School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  resultSheetId String?      @db.Uuid
  resultSheet   ResultSheet? @relation(fields: [resultSheetId], references: [id], onDelete: SetNull)
  examId        String       @db.Uuid
  exam          Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  classId       String       @db.Uuid
  class         Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId     String?      @db.Uuid
  student       Student?     @relation(fields: [studentId], references: [id], onDelete: SetNull)
  rollNo        Int
  studentName   String
  fatherName    String?
  subjectMarks  Json         @default("{}") @db.JsonB
  obtainedMarks Int?
  totalMarks    Int?
  percentage    Float?
  grade         String?
  position      Int?
  remarks       String?
  confidence    Json?        @db.JsonB
  linkedAt      DateTime?    @db.Timestamptz(6)
  deletedAt     DateTime?    @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)

  @@unique([examId, classId, rollNo])
  @@index([schoolId, studentId])
  @@index([schoolId, examId, classId])
  @@map("results")
}

model TimetableEntry {
