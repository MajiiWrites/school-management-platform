# School Management Platform — API environment (local dev, no Docker)
# Copy to `backend/.env` for local runs. For Docker, use the root `.env.example`.
#   cp backend/.env.example backend/.env
# Never commit `.env` to git. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"  # PHONE_ENC_KEY only

# --- Required ---
# Postgres connection. Local example (create the DB first, see docs/SETUP.md):
DATABASE_URL=postgresql://school:change-me@localhost:5432/school
# Port the API listens on (default 4000).
PORT=4000
# NODE_ENV=development enables dev fallbacks for missing secrets.
# In production it must be "production" (missing secrets then fail fast).
NODE_ENV=development
JWT_SECRET=change-me-dev-only-jwt-secret
JWT_REFRESH_SECRET=change-me-dev-only-jwt-refresh-secret
SMS_DEVICE_SECRET=change-me-dev-only-sms-device-secret
# 32 bytes, base64. BACK IT UP in production — losing it makes every stored
# parent phone number unreadable forever.
PHONE_ENC_KEY=change-me-dev-only-32-byte-base64-key

# --- Demo seeding (local dev only — never enable on the live site) ---
# false = never seed the demo school. Set to true ONLY for a local dev
# database (see backend/prisma/seed.ts); the live site must stay empty.
SEED_ON_BOOT=false

# --- Frontend origin (CORS) ---
FRONTEND_URL=http://localhost:5173
# Uploaded OCR images go here (relative to backend/ unless absolute).
UPLOAD_DIR=uploads
# Teacher attendance links stay valid this many days (default 90).
ATTENDANCE_LINK_TTL_DAYS=90

# --- OCR (optional) ---
# tesseract (default) = local Tesseract CLI; ai-vision = external API.
OCR_PROVIDER=tesseract
OCR_LANGS=eng+urd
# OCR_AI_VISION_URL=
# OCR_AI_VISION_KEY=

# --- Email (optional; verification/reset tokens are logged to console if unset) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=School Management <no-reply@school.local>

# --- SMS gateway fallback (optional; SIM via Android app is the default) ---
# SMS_GATEWAY_URL=
# SMS_GATEWAY_KEY=
# SMS_GATEWAY_FROM=
