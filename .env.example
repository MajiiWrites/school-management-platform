# School Management Platform — environment for docker compose
# Copy to `.env` and fill in REAL values. Never commit `.env` to git.
#   cp .env.example .env
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# (PHONE_ENC_KEY is base64 instead — see its note below.)

# --- Postgres (compose creates this database) ---
POSTGRES_USER=school
# CHANGE THIS to a long random password:
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=school

# --- API secrets (all required in production) ---
# Random hex strings (32+ bytes). Generate each one separately.
JWT_SECRET=change-me-jwt-secret
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret
# Device auth for the Android companion app (HMAC key, any long random string).
SMS_DEVICE_SECRET=change-me-sms-device-secret

# --- Phone encryption (CRITICAL) ---
# 32 bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BACK THIS UP OFF-SERVER. If it is lost, every stored parent phone number
# becomes unreadable forever and SMS can never be sent to existing parents.
PHONE_ENC_KEY=change-me-32-byte-base64-key

# --- URLs ---
# Public URL of the web frontend (used for CORS + links in emails).
FRONTEND_URL=http://localhost
# API base the frontend was built with. "/api/v1" = proxied by the web
# container's nginx (one origin). For separate hosting, use the full API URL,
# e.g. https://api.yourschool.pk/api/v1
VITE_API_URL=/api/v1

# --- First boot ---
# Demo seeding is OFF. Never enable it on the live site.
# Local dev only: set SEED_ON_BOOT=true to seed the demo school
# (see backend/prisma/seed.ts) on first boot, then set it back to false.
SEED_ON_BOOT=false

# --- OCR (optional; defaults are fine) ---
# tesseract = local Tesseract CLI (eng+urd, installed in the api image).
# ai-vision = external vision API (needs OCR_AI_VISION_URL + OCR_AI_VISION_KEY).
OCR_PROVIDER=tesseract
OCR_LANGS=eng+urd
# OCR_AI_VISION_URL=
# OCR_AI_VISION_KEY=

# --- Email (optional; verification/reset links are logged if unset) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=School Management <no-reply@school.local>

# --- SMS gateway fallback (optional; SIM via Android app is the default) ---
# SMS_GATEWAY_URL=
# SMS_GATEWAY_KEY=
# SMS_GATEWAY_FROM=
